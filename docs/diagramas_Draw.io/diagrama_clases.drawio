        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class tb_rol {\n        +int id_rol PK\n        +varchar(30) nombre_rol\n        +varchar(150) descripcion\n    }\n\n    class tb_usuario {\n        +int id_usuario PK\n        +int id_rol FK\n        +int id_empleado FK nullable\n        +varchar(50) nombre_usuario UNIQUE\n        +varchar(100) correo UNIQUE\n        +varchar(255) password_hash\n        +varchar(500) foto_perfil\n        +text preferencias\n        +tinyint estado\n        +datetime fecha_creacion\n    }\n\n    class tb_empleado {\n        +int id_empleado PK\n        +varchar(15) cedula\n        +varchar(50) primer_nombre\n        +varchar(50) segundo_nombre\n        +varchar(50) primer_apellido\n        +varchar(50) segundo_apellido\n        +int id_tipo_empleado FK\n        +int id_jornada FK\n        +decimal sueldo_divisa\n        +date fecha_ingreso\n        +tinyint estado\n    }\n\n    tb_rol \&quot;1\&quot; --&gt; \&quot;*\&quot; tb_usuario : id_rol\n    tb_empleado \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; tb_usuario : id_empleado\n\n    note for tb_rol \&quot;Roles del sistema:\\n1 = Administrador\\n2 = Personal de Apoyo\\n3 = Operador\&quot;\n    note for tb_usuario \&quot;id_empleado es NULLABLE:\\n- Admin: sin empleado\\n- Operador: vinculado opcional\\n- Apoyo: sin empleado\&quot;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="N7nb0EGRF90mmvRngGj_-1">
